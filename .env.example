# PostgreSQL Connection
DATABASE_URL="postgresql://timeswap:timeswap_dev_pass@localhost:5432/timeswap_db?schema=public"

# Redis Connection
REDIS_URL="redis://localhost:6379"

# API Server Configuration
PORT=4000
SESSION_SECRET="super-secret-dev-session-key-change-in-prod"
CORS_ORIGIN="http://localhost:3000"

# MinIO / Object Storage Configuration
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="timeswap-assets"
S3_REGION="us-east-1"

# Frontend Public URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# Google OAuth 2.0 Credentials (for "Continue with Google" sign-in)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Universal Transactional Email Service (Gmail SMTP / Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_char_app_password"
EMAIL_FROM="TimeSwap <your_email@gmail.com>"
RESEND_API_KEY="re_dev_placeholder"
