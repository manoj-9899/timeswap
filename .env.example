# TimeSwap Production Environment Variable Template (.env.example)

# 1. Database & Cache Store
DATABASE_URL="postgresql://user:password@host:5432/timeswap_db?sslmode=require"
REDIS_URL="rediss://default:password@redis-host:6379"

# 2. Server & Node Configuration
NODE_ENV="production"
PORT=4000
SESSION_SECRET="generate-64-character-random-hex-string-for-session-signing"
CORS_ORIGIN="https://timeswap-web.onrender.com"

# 3. Object Storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY="r2-access-key-id"
S3_SECRET_KEY="r2-secret-access-key"
S3_BUCKET="timeswap-assets"
S3_REGION="auto"

# 4. Public Web Client URLs
NEXT_PUBLIC_API_URL="https://timeswap-api.onrender.com"
NEXT_PUBLIC_WS_URL="wss://timeswap-api.onrender.com"

# 5. Third-Party Integrations
# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Transactional Email (Resend / Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="TimeSwap <onboarding@resend.dev>"
RESEND_API_KEY="re_your_resend_api_key"
