{
  "name": "timeswap-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:generate": "pnpm --filter @timeswap/database db:generate",
    "db:migrate": "pnpm --filter @timeswap/database db:migrate",
    "db:deploy": "pnpm --filter @timeswap/database db:deploy",
    "db:seed": "pnpm --filter @timeswap/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.24.0"
}
